1 ICON "..\icons\icon.ico"

// Fill in the PE version resource. An exe without CompanyName / copyright /
// original filename scores noticeably worse in static AV heuristics, and the
// Authenticode signature has a meaningful publisher name to attach to.
// Keep the numeric version in sync with Cargo.toml.
1 VERSIONINFO
FILEVERSION 0,2,4,0
PRODUCTVERSION 0,2,4,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "QookiX"
      VALUE "FileDescription", "QookiX Launcher Installer UI"
      VALUE "FileVersion", "0.2.4.0"
      VALUE "InternalName", "QookiXInstallerUI"
      VALUE "LegalCopyright", "Copyright (C) QookiX"
      VALUE "OriginalFilename", "QookiXInstallerUI.exe"
      VALUE "ProductName", "QookiX Launcher"
      VALUE "ProductVersion", "0.2.4.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
